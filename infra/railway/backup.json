{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/backup.Dockerfile",
    "watchPatterns": ["infra/backup/**", "infra/docker/backup.Dockerfile"]
  },
  "deploy": {
    "cronSchedule": "43 1 * * *",
    "restartPolicyType": "NEVER"
  }
}
