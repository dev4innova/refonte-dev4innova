{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/api.Dockerfile",
    "watchPatterns": ["apps/api/**", "infra/docker/api.Dockerfile"]
  },
  "deploy": {
    "startCommand": "python -m app.cli daily",
    "cronSchedule": "17 2 * * *",
    "restartPolicyType": "NEVER"
  }
}
