# Copy to infra/docker/.env to override the local defaults of compose.yaml.
# Local development values only: production secrets never live in a file.
APP_ENV=local
LOG_LEVEL=INFO
POSTGRES_USER=dev4innova
POSTGRES_PASSWORD=dev4innova
POSTGRES_DB=dev4innova
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
SITE_URL=http://localhost:3000
MINIO_ROOT_USER=dev4innova
MINIO_ROOT_PASSWORD=dev4innova-secret
MINIO_PORT=9000
# AI Gateway provider keys (optional). Keep them in infra/docker/.env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_ENABLE_SIMULATED_PROVIDER=true
