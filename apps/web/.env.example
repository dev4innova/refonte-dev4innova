# Copy to .env.local for `pnpm dev` outside Docker. Never commit .env files.
# Server-side only: URL the Next.js server uses to reach the API.
API_URL=http://localhost:8000
# Public origin used for canonical and hreflang URLs (read at build time).
SITE_URL=http://localhost:3000

# Sign-in with Zitadel (docs/architecture/authentication.md). Leave empty to disable.
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_PROJECT_ID=
# Random string of at least 32 characters (e.g. `openssl rand -base64 32`). Never commit it.
AUTH_SESSION_SECRET=
