# Copy to .env.local for `pnpm dev` outside Docker. Never commit .env files.
# Server-side only: URL the Next.js server uses to reach the API.
API_URL=http://localhost:8000
# Public origin used for canonical and hreflang URLs (read at build time).
SITE_URL=http://localhost:3000

# Sign-in uses the built-in accounts of the API (ADR-0019): nothing to configure.

# Search engine indexing (robots.txt). true ONLY in production, never in staging.
ALLOW_INDEXING=false
