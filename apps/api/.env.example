# Copy to .env for running the API outside Docker. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
# Error tracking (EPIC 14, ADR-0018): Sentry DSN, empty = disabled.
SENTRY_DSN=
DATABASE_URL=postgresql+asyncpg://dev4innova:dev4innova@localhost:5432/dev4innova
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Identity provider (Zitadel). Leave empty locally to disable authenticated endpoints.
AUTH_ISSUER=
AUTH_AUDIENCE=
TRUST_FORWARDED_FOR=false
# Media storage (S3-compatible). Locally: MinIO from Docker Compose.
MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_BUCKET=dev4innova-media
MEDIA_S3_ACCESS_KEY_ID=dev4innova
MEDIA_S3_SECRET_ACCESS_KEY=dev4innova-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/dev4innova-media
# Client portal (EPIC 11): private bucket, same credentials; never readable anonymously.
PORTAL_S3_BUCKET=dev4innova-portal
# PORTAL_S3_PUBLIC_ENDPOINT_URL=  # S3 endpoint seen by browsers, if different (signed links)
PORTAL_FILE_MAX_BYTES=26214400
PORTAL_DOWNLOAD_TTL_SECONDS=300
# Academy (EPIC 12): public address of the website, printed on certificates.
SITE_URL=http://localhost:3000
# Commerce and billing (EPIC 13). Stripe keys are secrets: deployment secrets only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Offline payment pages served by the API, for local development (never in production).
BILLING_SIMULATED_PAYMENTS=true
API_PUBLIC_URL=http://localhost:8000
BILLING_SELLER_NAME=DEV4INNOVA
BILLING_SELLER_LEGAL_FORM=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_SIREN=
BILLING_SELLER_VAT_NUMBER=
BILLING_SELLER_IBAN=
BILLING_SELLER_BIC=
BILLING_SELLER_EMAIL=
BILLING_PAYMENT_TERMS_DAYS=30
# AI Gateway (ADR-0007, ADR-0012). Keys stay in the backend; leave empty to disable a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_EUR_PER_USD=0.86
AI_DEFAULT_MONTHLY_BUDGET_EUR=20
AI_USER_REQUESTS_PER_MINUTE=20
# Offline echo provider for local development (never in production).
AI_ENABLE_SIMULATED_PROVIDER=true
# AI experiences (EPIC 09): retention of the sessions and abuse limits.
AI_SESSION_RETENTION_DAYS=90
AI_DAILY_MESSAGES_PER_USER=200
# AI diagnostic (EPIC 10): public AI analyses per day, all respondents together.
AI_DIAGNOSTIC_DAILY_ANALYSES=300
